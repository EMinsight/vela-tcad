{
  "simulation_type": "dc_sweep",
  "mesh_file": "mesh.json",
  "node_doping_file": "doping.csv",
  "materials_file": "pn2d_minimal6_materials.json",
  "scaling": {
    "mode": "unit_scaling"
  },
  "contacts": [
    {
      "name": "Anode",
      "bias": 0.0
    },
    {
      "name": "Cathode",
      "bias": 0.0
    }
  ],
  "solver": {
    "method": "gummel_newton",
    "max_iter": 40,
    "reltol": 1e-8,
    "abstol": 1e-9,
    "contact_boundary_minority_electron_relaxation": false,
    "mobility": {
      "model": "masetti_field",
      "high_field_driving_force": "electric_field"
    },
    "recombination": [
      "srh"
    ],
    "bandgap_narrowing": "old_slotboom",
    "impact_ionization": {
      "model": "van_overstraeten",
      "driving_force": "electric_field",
      "generation": "current_density",
      "current_approximation": "element_edge_sg_gss_laux",
      "quasi_fermi_gradient_discretization": "edge_difference",
      "source_mapping_mode": "element_vertex_box_measure"
    },
    "handoff": {
      "fallback": "none",
      "require_gummel_convergence": false,
      "gummel_max_iter": 0,
      "newton_max_iter": 40
    }
  },
  "sweep": {
    "mode": "bv_reverse",
    "contact": "Anode",
    "current_contact": "Anode",
    "start": 0.0,
    "stop": -1.0,
    "step": -0.05,
    "min_step": 1e-10,
    "max_step": 0.05,
    "growth_factor": 1.2,
    "shrink_factor": 0.5,
    "max_retries": 29,
    "write_vtk": false,
    "write_state_every_point_prefix": "states/segment",
    "diagnostics": {
      "sg_avalanche_edges": {
        "enabled": true,
        "csv_file": "diagnostics/sg_avalanche_edges.csv"
      },
      "terminal_current_method_compare": {
        "enabled": true,
        "contacts": [
          "Anode",
          "Cathode"
        ],
        "csv_file": "diagnostics/terminal_current_method_compare.csv"
      }
    }
  }
}
