{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vela.pn2d_minimal6_sweep_manifest.v1",
  "type": "object",
  "allOf": [{"$ref": "#/$defs/noRawStateTree"}],
  "required": [
    "schema", "diagnostic_disclaimer", "targets_V", "template",
    "topology_input_sha256", "segments", "sentaurus_segments",
    "accepted_checkpoints", "failed_transition", "failed_transitions",
    "interpolation", "branch_threshold_version"
  ],
  "properties": {
    "schema": {"const": "vela.pn2d_minimal6_sweep_manifest.v1"},
    "diagnostic_disclaimer": {"const": "minimal6 diagnostic sweep; not a physical BV curve"},
    "targets_V": {"type": "array", "minItems": 1, "maxItems": 21,
                  "items": {"type": "number"}, "uniqueItems": true},
    "template": {"type": "object", "required": ["sha256"],
                 "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}},
                 "additionalProperties": true},
    "topology_input_sha256": {"type": "object", "minProperties": 1,
                              "additionalProperties": {"type": "object", "minProperties": 1,
                                                       "additionalProperties": {"$ref": "#/$defs/sha256"}}},
    "segments": {"type": "array", "items": {"type": "object"}},
    "sentaurus_segments": {"type": "array", "items": {"type": "object"}},
    "accepted_checkpoints": {"type": "array", "items": {"$ref": "#/$defs/acceptedCheckpoint"}},
    "failed_transition": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/failedTransition"}]},
    "failed_transitions": {"type": "array", "items": {"$ref": "#/$defs/failedTransition"}},
    "interpolation": {"const": "forbidden"},
    "branch_threshold_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "noRawStateTree": {
      "not": {"type": "object", "anyOf": [
        {"required": ["raw_state"]}, {"required": ["raw_states"]},
        {"required": ["state_payload"]}, {"required": ["state_vectors"]},
        {"required": ["state_values"]}
      ]},
      "additionalProperties": {"$ref": "#/$defs/noRawStateTree"},
      "items": {"$ref": "#/$defs/noRawStateTree"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "observables": {
      "type": "object",
      "required": ["anode_current_A_per_um", "cathode_current_A_per_um", "max_field_V_per_m",
                   "native_source_integral_s_inv_per_cm", "reconstructed_source_integral_s_inv_per_cm"],
      "properties": {
        "anode_current_A_per_um": {"type": "number"}, "cathode_current_A_per_um": {"type": "number"},
        "max_field_V_per_m": {"type": "number"},
        "native_source_integral_s_inv_per_cm": {"type": "number"},
        "reconstructed_source_integral_s_inv_per_cm": {"type": "number"}
      }, "additionalProperties": false
    },
    "acceptedCheckpoint": {
      "type": "object",
      "required": ["solver", "topology", "start_bias_V", "target_bias_V", "actual_bias_V",
                   "status", "state_path", "state_sha256", "observables", "branch_classification",
                   "branch_threshold_version", "convergence_metadata"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]}, "topology": {"enum": ["sketch", "mirror"]},
        "start_bias_V": {"type": "number"}, "target_bias_V": {"type": "number"},
        "actual_bias_V": {"type": "number"}, "status": {"const": "accepted"},
        "state_path": {"type": "string", "minLength": 1}, "state_sha256": {"$ref": "#/$defs/sha256"},
        "observables": {"$ref": "#/$defs/observables"},
        "branch_classification": {"enum": ["leakage_like", "multiplication_like", "unidentified"]},
        "branch_threshold_version": {"type": "string", "minLength": 1},
        "convergence_metadata": {"type": "object", "minProperties": 1}
      }, "additionalProperties": true
    },
    "failedTransition": {
      "type": "object",
      "required": ["solver", "topology", "start_bias_V", "target_bias_V", "status", "observables",
                   "branch_classification", "branch_threshold_version", "convergence_metadata"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]}, "topology": {"enum": ["sketch", "mirror"]},
        "start_bias_V": {"type": "number"}, "target_bias_V": {"type": "number"},
        "status": {"const": "rejected"}, "observables": {"type": "null"},
        "branch_classification": {"const": "unidentified"},
        "branch_threshold_version": {"type": "string", "minLength": 1},
        "convergence_metadata": {"type": "object", "minProperties": 1}
      }, "additionalProperties": true
    }
  },
  "additionalProperties": true
}
