{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vela.pn2d_minimal6_formula_difference.v1",
  "type": "object",
  "required": [
    "schema", "diagnostic_disclaimer", "input_provenance", "audit_provenance",
    "state_matrix", "row_counts", "waterfall_paths", "interactions",
    "dominance_rules", "sentaurus_internal_semantics_residual",
    "vela_parameter_agreement", "artifact_hashes", "records"
  ],
  "properties": {
    "schema": {"const": "vela.pn2d_minimal6_formula_difference.v1"},
    "diagnostic_disclaimer": {"const": "minimal6 diagnostic sweep; not a physical BV curve"},
    "input_provenance": {"type": "object", "minProperties": 1},
    "audit_provenance": {"type": "object", "minProperties": 1},
    "state_matrix": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "sketch"}, "requested_bias_V": {"const": 0}, "actual_bias_V": {"type": "number", "minimum": -1e-12, "maximum": 1e-12}, "status": {"const": "passed"}}, "additionalProperties": false},
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "sketch"}, "requested_bias_V": {"const": -12}, "actual_bias_V": {"type": "number", "minimum": -12.000000000001, "maximum": -11.999999999999}, "status": {"const": "passed"}}, "additionalProperties": false},
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "sketch"}, "requested_bias_V": {"const": -19}, "actual_bias_V": {"type": "number", "minimum": -19.000000000001, "maximum": -18.999999999999}, "status": {"const": "passed"}}, "additionalProperties": false},
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "mirror"}, "requested_bias_V": {"const": 0}, "actual_bias_V": {"type": "number", "minimum": -1e-12, "maximum": 1e-12}, "status": {"const": "passed"}}, "additionalProperties": false},
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "mirror"}, "requested_bias_V": {"const": -12}, "actual_bias_V": {"type": "number", "minimum": -12.000000000001, "maximum": -11.999999999999}, "status": {"const": "passed"}}, "additionalProperties": false},
        {"type": "object", "required": ["topology_id", "requested_bias_V", "actual_bias_V", "status"], "properties": {"topology_id": {"const": "mirror"}, "requested_bias_V": {"const": -19}, "actual_bias_V": {"type": "number", "minimum": -19.000000000001, "maximum": -18.999999999999}, "status": {"const": "passed"}}, "additionalProperties": false}
      ],
      "items": false
    },
    "row_counts": {
      "type": "object", "required": ["node", "edge", "triangle"],
      "properties": {"node": {"const": 36}, "edge": {"const": 54}, "triangle": {"const": 24}},
      "additionalProperties": false
    },
    "waterfall_paths": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/waterfallPath"}
    },
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/stateInteraction"}, "uniqueItems": true},
    "dominance_rules": {"type": "object", "minProperties": 1},
    "sentaurus_internal_semantics_residual": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["topology", "bias_V", "name", "classification"],
        "properties": {
          "topology": {"enum": ["sketch", "mirror"]}, "bias_V": {"enum": [0, -12, -19]},
          "name": {"const": "sentaurus_internal_semantics_residual"},
          "classification": {"type": "string"}, "dex": {"type": ["number", "null"]}
        }, "additionalProperties": true
      }
    },
    "vela_parameter_agreement": {"type": "array"},
    "artifact_hashes": {
      "type": "object", "required": ["state_manifest_sha256"],
      "properties": {"state_manifest_sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": true
    },
    "records": {"type": "array"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "pathDefinition": {
      "type": "object", "required": ["order", "contributions"], "minProperties": 2,
      "properties": {
        "order": {"type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}},
        "contributions": {"type": "array", "items": {"type": "object"}}
      }, "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": ["first_factor", "second_factor", "path_identity", "baseline", "a_only", "b_only", "both", "interaction_dex"],
      "properties": {
        "first_factor": {"type": "string", "minLength": 1},
        "second_factor": {"type": "string", "minLength": 1},
        "path_identity": {"type": "string", "minLength": 1},
        "baseline": {"type": "number"}, "a_only": {"type": "number"},
        "b_only": {"type": "number"}, "both": {"type": "number"},
        "interaction_dex": {"type": "number"}
      }, "additionalProperties": false
    },
    "stateInteraction": {
      "type": "object",
      "required": ["topology", "bias_V", "first_factor", "second_factor", "path_identity", "baseline", "a_only", "b_only", "both", "interaction_dex"],
      "properties": {
        "topology": {"enum": ["sketch", "mirror"]}, "bias_V": {"enum": [0, -12, -19]},
        "first_factor": {"type": "string", "minLength": 1},
        "second_factor": {"type": "string", "minLength": 1},
        "path_identity": {"type": "string", "minLength": 1},
        "baseline": {"type": "number"}, "a_only": {"type": "number"},
        "b_only": {"type": "number"}, "both": {"type": "number"},
        "interaction_dex": {"type": "number"}
      }, "additionalProperties": false
    },
    "waterfallPath": {
      "type": "object",
      "required": ["topology", "bias_V", "forward", "reverse", "interactions", "residual_dex", "status"],
      "properties": {
        "topology": {"enum": ["sketch", "mirror"]}, "bias_V": {"enum": [0, -12, -19]},
        "forward": {"$ref": "#/$defs/pathDefinition"},
        "reverse": {"$ref": "#/$defs/pathDefinition"},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}, "uniqueItems": true},
        "residual_dex": {"type": ["number", "null"]}, "status": {"type": "string"}
      }, "additionalProperties": true
    }
  },
  "additionalProperties": true
}
