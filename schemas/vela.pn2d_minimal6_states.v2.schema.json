{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vela.pn2d_minimal6_states.v2",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "source_kind",
    "source_schema",
    "source_run_id",
    "source_manifest_path",
    "source_manifest_sha256",
    "bias_tolerance_V",
    "outputs_complete",
    "states"
  ],
  "properties": {
    "schema": {"const": "vela.pn2d_minimal6_states.v2"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "source_kind": {"enum": ["local_recovery", "regenerated"]},
    "source_schema": {"const": "vela.pn2d_minimal6_states.v1"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_manifest_path": {"const": "source_manifest.json"},
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bias_tolerance_V": {"type": "number", "const": 1e-12},
    "outputs_complete": {"const": true},
    "audit_provenance": {"type": "object"},
    "states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "topology_id",
          "requested_bias_V",
          "actual_bias_V",
          "bias_tag",
          "status",
          "topology_contract",
          "export_dir",
          "field_manifest",
          "fields",
          "raw_artifacts"
        ],
        "properties": {
          "topology_id": {"enum": ["sketch", "mirror"]},
          "requested_bias_V": {"type": "number"},
          "actual_bias_V": {"type": "number"},
          "bias_tag": {"type": "string", "minLength": 1},
          "status": {"const": "passed"},
          "topology_contract": {
            "type": "object",
            "required": [
              "nodes",
              "triangles",
              "edges",
              "contact_edges",
              "triangle_connectivity"
            ],
            "properties": {
              "nodes": {"const": 6},
              "triangles": {"const": 4},
              "edges": {"const": 9},
              "contact_edges": {
                "type": "object",
                "required": ["Anode", "Cathode"],
                "properties": {
                  "Anode": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "integer"}
                  },
                  "Cathode": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "integer"}
                  }
                },
                "additionalProperties": false
              },
              "triangle_connectivity": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "integer"}
                }
              }
            },
            "additionalProperties": false
          },
          "export_dir": {"type": "string", "minLength": 1},
          "field_manifest": {"type": "string", "minLength": 1},
          "state_csv": {"type": "string", "minLength": 1},
          "fields": {
            "type": "array",
            "minItems": 18,
            "maxItems": 18,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "normalized_name",
                "raw_name",
                "components",
                "unit",
                "semantic_role"
              ],
              "properties": {
                "normalized_name": {"type": "string", "minLength": 1},
                "raw_name": {"type": "string", "minLength": 1},
                "components": {"type": "integer"},
                "unit": {"type": "string", "minLength": 1},
                "semantic_role": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "raw_artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
