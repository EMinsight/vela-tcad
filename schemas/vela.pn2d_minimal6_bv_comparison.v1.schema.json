{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vela.pn2d_minimal6_bv_comparison.v1",
  "type": "object",
  "allOf": [{"$ref": "#/$defs/noRawStateTree"}],
  "required": [
    "schema", "diagnostic_disclaimer", "interpolation", "branch_threshold_version",
    "solver_configurations", "accepted_transitions", "failed_transitions",
    "failure_transitions", "checkpoints", "terminal_currents", "maximum_fields",
    "source_integrals", "convergence_metadata", "curve_artifact_hashes", "records",
    "deepest_common_bias_V", "missing_tails", "topology_sensitivity",
    "fixed_state_recheck", "artifact_hashes", "input_artifacts", "figure_contract", "closure"
  ],
  "properties": {
    "schema": {"const": "vela.pn2d_minimal6_bv_comparison.v1"},
    "diagnostic_disclaimer": {"const": "minimal6 diagnostic sweep; not a physical BV curve"},
    "interpolation": {"const": "forbidden"},
    "branch_threshold_version": {"const": "v1: multiplication=[0.1,10], leakage<=1e-3"},
    "solver_configurations": {
      "type": "object", "required": ["vela", "sentaurus"],
      "properties": {"vela": {"$ref": "#/$defs/solverConfiguration"},
                     "sentaurus": {"$ref": "#/$defs/solverConfiguration"}},
      "additionalProperties": false
    },
    "accepted_transitions": {
      "type": "object", "required": ["vela", "sentaurus"],
      "properties": {
        "vela": {"type": "array", "items": {"$ref": "#/$defs/acceptedTransition"}},
        "sentaurus": {"type": "array", "items": {"$ref": "#/$defs/acceptedTransition"}}
      }, "additionalProperties": false
    },
    "failed_transitions": {"type": "array", "items": {"$ref": "#/$defs/failedTransition"}},
    "failure_transitions": {"type": "array", "items": {"$ref": "#/$defs/failedTransition"}},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/comparisonCheckpoint"}},
    "terminal_currents": {"type": "array"}, "maximum_fields": {"type": "array"},
    "source_integrals": {"type": "array"}, "records": {"type": "array"},
    "convergence_metadata": {"type": "object", "minProperties": 1},
    "curve_artifact_hashes": {
      "type": "object", "required": ["vela_manifest", "sentaurus_manifest"],
      "properties": {"vela_manifest": {"$ref": "#/$defs/sha256"},
                     "sentaurus_manifest": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": true
    },
    "deepest_common_bias_V": {"type": "object"}, "missing_tails": {"type": "array"},
    "topology_sensitivity": {"type": "array"}, "fixed_state_recheck": {"type": "array"},
    "artifact_hashes": {"type": "object"}, "input_artifacts": {"type": "object"},
    "figure_contract": {
      "type": "object", "required": ["schema", "figures"],
      "properties": {
        "schema": {"const": "vela.pn2d_minimal6_figure_contract.v1"},
        "figures": {
          "type": "object", "required": ["terminal_current.png", "one_volt_growth.png", "maximum_field.png", "source_integrals.png", "topology.png"],
          "additionalProperties": false,
          "properties": {
            "terminal_current.png": {"$ref": "#/$defs/figureEntry"}, "one_volt_growth.png": {"$ref": "#/$defs/figureEntry"},
            "maximum_field.png": {"$ref": "#/$defs/figureEntry"}, "source_integrals.png": {"$ref": "#/$defs/figureEntry"}, "topology.png": {"$ref": "#/$defs/figureEntry"}
          }
        }
      }, "additionalProperties": false
    },
    "closure": {
      "type": "object", "required": ["status", "eligible_gaps", "rule"],
      "properties": {
        "status": {"const": "closed"},
        "eligible_gaps": {"type": "integer", "minimum": 0},
        "rule": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }
  },
  "$defs": {
    "noRawStateTree": {
      "not": {"type": "object", "anyOf": [
        {"required": ["raw_state"]}, {"required": ["raw_states"]},
        {"required": ["state_payload"]}, {"required": ["state_vectors"]},
        {"required": ["state_values"]}
      ]},
      "additionalProperties": {"$ref": "#/$defs/noRawStateTree"},
      "items": {"$ref": "#/$defs/noRawStateTree"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "observables": {
      "type": "object",
      "required": ["anode_current_A_per_um", "cathode_current_A_per_um", "max_field_V_per_m",
                   "native_source_integral_s_inv_per_cm", "reconstructed_source_integral_s_inv_per_cm"],
      "properties": {
        "anode_current_A_per_um": {"type": "number"}, "cathode_current_A_per_um": {"type": "number"},
        "max_field_V_per_m": {"type": "number"},
        "native_source_integral_s_inv_per_cm": {"type": "number"},
        "reconstructed_source_integral_s_inv_per_cm": {"type": "number"}
      }, "additionalProperties": false
    },
    "acceptedTransition": {
      "type": "object",
      "required": ["solver", "topology", "target_bias_V", "actual_bias_V", "status", "state_path", "state_sha256", "observables",
                   "branch_classification", "branch_threshold_version", "convergence_metadata"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]}, "topology": {"enum": ["sketch", "mirror"]},
        "target_bias_V": {"type": "number"}, "actual_bias_V": {"type": "number"},
        "status": {"const": "accepted"},
        "state_path": {"type": "string", "minLength": 1}, "state_sha256": {"$ref": "#/$defs/sha256"},
        "observables": {"$ref": "#/$defs/observables"},
        "branch_classification": {"enum": ["leakage_like", "multiplication_like", "unidentified"]},
        "branch_threshold_version": {"const": "v1: multiplication=[0.1,10], leakage<=1e-3"},
        "convergence_metadata": {"type": "object", "minProperties": 1},
        "quantity_ledger_result": {"$ref": "#/$defs/quantityLedgerResult"}
      }, "additionalProperties": true
    },
    "failedTransition": {
      "type": "object",
      "required": ["solver", "topology", "target_bias_V", "status", "state_path", "state_sha256", "observables",
                   "branch_classification", "branch_threshold_version", "convergence_metadata"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]}, "topology": {"enum": ["sketch", "mirror"]},
        "target_bias_V": {"type": "number"}, "status": {"const": "rejected"},
        "observables": {"type": "null"}, "branch_classification": {"const": "unidentified"},
        "branch_threshold_version": {"const": "v1: multiplication=[0.1,10], leakage<=1e-3"},
        "convergence_metadata": {"type": "object", "minProperties": 1}
      }, "additionalProperties": true
    },
    "comparisonCheckpoint": {
      "type": "object",
      "required": ["topology", "bias_V", "vela", "sentaurus", "branch_classification", "branch_threshold_version",
                   "contact_current_conservation", "branch_ratio_evidence", "terminal_current_ratio",
                   "maximum_field_ratio", "native_source_ratio", "reconstructed_source_ratio", "gap_closure"],
      "properties": {
        "topology": {"enum": ["sketch", "mirror"]}, "bias_V": {"type": "number"},
        "vela": {"$ref": "#/$defs/acceptedTransition"},
        "sentaurus": {"$ref": "#/$defs/acceptedTransition"},
        "branch_classification": {"enum": ["leakage_like", "multiplication_like", "unidentified"]},
        "branch_threshold_version": {"const": "v1: multiplication=[0.1,10], leakage<=1e-3"},
        "contact_current_conservation": {"$ref": "#/$defs/contactConservation"},
        "branch_ratio_evidence": {"$ref": "#/$defs/branchRatioEvidence"},
        "terminal_current_ratio": {"$ref": "#/$defs/ratioRecord"},
        "maximum_field_ratio": {"$ref": "#/$defs/ratioRecord"},
        "native_source_ratio": {"$ref": "#/$defs/ratioRecord"},
        "reconstructed_source_ratio": {"$ref": "#/$defs/ratioRecord"},
        "gap_closure": {"$ref": "#/$defs/gapClosure"}
      }, "additionalProperties": true
    },
    "ratioRecord": {
      "type": "object", "required": ["classification", "value"],
      "properties": {
        "classification": {"enum": ["available", "zero_denominator", "zero_numerator", "geometric_zero", "unavailable"]},
        "value": {"type": ["number", "null"]}
      }, "additionalProperties": false
    },
    "branchRatioEvidence": {
      "type": "object",
      "required": ["vela_anode_current_A_per_um", "sentaurus_anode_current_A_per_um", "absolute_vela_over_sentaurus", "geometric_zero", "threshold_version"],
      "properties": {
        "vela_anode_current_A_per_um": {"type": "number"},
        "sentaurus_anode_current_A_per_um": {"type": "number"},
        "absolute_vela_over_sentaurus": {"type": ["number", "null"]},
        "geometric_zero": {"type": "boolean"},
        "threshold_version": {"const": "v1: multiplication=[0.1,10], leakage<=1e-3"}
      }, "additionalProperties": false
    },
    "namedContribution": {
      "type": "object", "required": ["name", "contribution_dex"],
      "properties": {"name": {"type": "string", "minLength": 1}, "contribution_dex": {"type": "number"}},
      "additionalProperties": false
    },
    "gapResidual": {
      "type": "object", "required": ["name", "classification", "value_dex"],
      "properties": {
        "name": {"const": "cross_solver_semantics_residual"},
        "classification": {"enum": ["available", "unidentifiable"]},
        "value_dex": {"type": ["number", "null"]}
      }, "additionalProperties": false
    },
    "gapRecord": {
      "type": "object",
      "required": ["quantity", "classification", "log_gap_dex", "named_contributions", "residual", "closure_error_dex"],
      "properties": {
        "quantity": {"enum": ["terminal_current", "maximum_field", "native_source", "reconstructed_source"]},
        "classification": {"enum": ["available", "zero_denominator", "zero_numerator", "geometric_zero", "unavailable"]},
        "log_gap_dex": {"type": ["number", "null"]},
        "named_contributions": {"type": "array", "items": {"$ref": "#/$defs/namedContribution"}},
        "residual": {"$ref": "#/$defs/gapResidual"},
        "closure_error_dex": {"type": ["number", "null"]}
      }, "additionalProperties": false
    },
    "gapClosure": {
      "type": "object", "required": ["status", "tolerance_dex", "gaps"],
      "properties": {
        "status": {"const": "closed"},
        "tolerance_dex": {"const": 1e-10},
        "gaps": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/gapRecord"}}
      }, "additionalProperties": false
    },
    "ledgerClosure": {
      "type": "object", "required": ["status", "tolerance_dex", "closure_error_dex"],
      "properties": {
        "status": {"const": "closed"},
        "tolerance_dex": {"const": 1e-10},
        "closure_error_dex": {"type": "number"}
      }, "additionalProperties": false
    },
    "quantityLedgerResult": {
      "type": "object", "required": ["state_sha256", "status", "dominant_factor", "ranking", "closure"],
      "properties": {
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "available"},
        "dominant_factor": {"type": "string", "minLength": 1},
        "ranking": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "closure": {"$ref": "#/$defs/ledgerClosure"}
      }, "additionalProperties": false
    },
    "solverConfiguration": {
      "type": "object",
      "required": ["template", "topology_input_sha256", "deck_sha256", "configuration_sha256"],
      "properties": {
        "template": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
        "topology_input_sha256": {
          "type": "object", "required": ["sketch", "mirror"],
          "properties": {
            "sketch": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
            "mirror": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
          }, "additionalProperties": false
        },
        "deck_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "configuration_sha256": {"$ref": "#/$defs/sha256"}
      }, "additionalProperties": false
    },
    "figureMetadata": {
      "type": "object", "required": ["DiagnosticDisclaimer", "SolverTermination", "BVExtrapolation"],
      "properties": {
        "DiagnosticDisclaimer": {"const": "minimal6 diagnostic sweep; not a physical BV curve"},
        "SolverTermination": {"const": "Every recorded solver failure transition is explicitly marked."},
        "BVExtrapolation": {"const": "No physical breakdown voltage (BV) is extrapolated."}
      }, "additionalProperties": false
    },
    "figureSeriesIdentity": {
      "type": "object", "required": ["solver", "quantity"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]},
        "topology": {"enum": ["sketch", "mirror"]},
        "quantity": {"enum": ["terminal_current", "maximum_field", "native_source", "reconstructed_source", "one_volt_growth", "terminal_current_sketch_over_mirror"]}
      }, "additionalProperties": false
    },
    "figureFailureTransitionMarker": {
      "type": "object", "required": ["solver", "topology", "start_bias_V", "target_bias_V"],
      "properties": {
        "solver": {"enum": ["vela", "sentaurus"]}, "topology": {"enum": ["sketch", "mirror"]},
        "start_bias_V": {"type": "number"}, "target_bias_V": {"type": "number"}
      }, "additionalProperties": false
    },
    "figureEntry": {
      "type": "object", "required": ["sha256", "width_px", "height_px", "metadata", "series_identities", "failure_transition_markers"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}, "width_px": {"const": 900}, "height_px": {"const": 504},
        "metadata": {"$ref": "#/$defs/figureMetadata"},
        "series_identities": {"type": "array", "items": {"$ref": "#/$defs/figureSeriesIdentity"}},
        "failure_transition_markers": {"type": "array", "items": {"$ref": "#/$defs/figureFailureTransitionMarker"}}
      }, "additionalProperties": false
    },
    "contactEvidence": {
      "type": "object",
      "required": ["anode_current_A_per_um", "cathode_current_A_per_um", "signed_residual_A_per_um", "tolerance_A_per_um", "tolerance_formula", "classification"],
      "properties": {
        "anode_current_A_per_um": {"type": "number"}, "cathode_current_A_per_um": {"type": "number"},
        "signed_residual_A_per_um": {"type": "number"}, "tolerance_A_per_um": {"type": "number", "exclusiveMinimum": 0},
        "tolerance_formula": {"const": "max(1e-18 A/um, 1e-9 * max(|Anode|, |Cathode|))"},
        "classification": {"enum": ["conserved", "not_conserved"]}
      }, "additionalProperties": false
    },
    "contactConservation": {
      "type": "object", "required": ["unit", "vela", "sentaurus"],
      "properties": {"unit": {"const": "A/um"}, "vela": {"$ref": "#/$defs/contactEvidence"},
                     "sentaurus": {"$ref": "#/$defs/contactEvidence"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
